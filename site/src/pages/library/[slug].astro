---
import { sitePath } from '../../lib/links';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Code } from 'astro:components';
import { readFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
export async function getStaticPaths() {
  return (await getCollection('library')).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const code = await readFile(new URL(`../../../../library/${entry.data.example}/example/policy.mjs`, import.meta.url), 'utf8');
const digest = createHash('sha256').update(code).digest('hex').slice(0, 12);
const repository = import.meta.env.PORTFOLIO_REPOSITORY;
const revision = import.meta.env.PORTFOLIO_REVISION;
if (repository && !/^https:\/\/github\.com\/[\w.-]+\/[\w.-]+$/.test(repository)) throw new Error('PORTFOLIO_REPOSITORY must be a GitHub repository URL');
if (repository && !/^[a-f0-9]{40}$/.test(revision || '')) throw new Error('Set PORTFOLIO_REVISION to the matching full commit');
const sourceLink = repository ? `${repository}/tree/${revision}/library/${entry.data.example}/example` : null;
---
<Layout title={entry.data.title} description={entry.data.description} kind="article" article={{ category: entry.data.category, tags: entry.data.tags, reviewed: entry.data.reviewed }}>
  <section class="page-heading article-heading"><a class="text-link" href={sitePath('/library/')}>← Engineering Library</a><p class="eyebrow" style="margin-top:30px">{entry.data.category}</p><h1>{entry.data.title}</h1><p class="intro">{entry.data.description}</p><div class="article-meta"><span class="badge">Example: {entry.data.maturity}</span><span>By <a href={sitePath('/#about-heading')}>Luke Hallett</a></span><span>Reviewed <time datetime={entry.data.reviewed}>{entry.data.reviewed}</time></span><span>{entry.data.tags.join(' / ')}</span></div><div class="callout">Source application: {entry.data.sourceApplication}. {entry.data.sourceMaturity}.</div></section>
  <div class="article-grid"><aside class="toc"><strong>In this entry</strong>{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}<a href="#working-code">Working code</a></aside><article class="prose"><Content /><h2 id="working-code">Working code</h2><p>This excerpt is read from the runnable example at build time. File SHA-256: <code>{digest}</code>.</p><Code code={code} lang="javascript" theme="github-dark-high-contrast" /><div class="source-actions"><a class="button" href={sitePath(`/examples/${entry.id}/README.md`)}>Example setup ↗</a><a class="button" href={sitePath(`/examples/${entry.id}/policy.mjs`)} download>Download policy ↓</a>{sourceLink && <a class="button" href={sourceLink}>Matching GitHub example ↗</a>}</div>{!sourceLink && <p class="draft-note">GitHub link pending repository publication and a matching commit. All example files are available in this local repository.</p>}</article></div>
</Layout>
